# Copy to .env. Leave blank if Tesseract is on PATH.
TESSERACT_CMD=
# Windows example (use forward slashes):
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Usually unnecessary; set only if Tesseract cannot locate its language data.
# TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata

# Output raster budgets. Lower pixels for machines with limited RAM (e.g. 6000000).
MAX_RENDER_PIXELS=12000000
MAX_RENDER_SIDE=6000
